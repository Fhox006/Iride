+fun Modifier.scrolledTopBarBackground(
+    progress: Float,
+    barColor: Color,
+    strokeColor: Color,
+): Modifier = drawBehind {
+    val p = progress.coerceIn(0f, 1f)
+    if (p <= 0f) return@drawBehind
+    drawRect(barColor, alpha = p)
+    val sw = 1.dp.toPx()
+    val y = size.height - sw / 2f
+    drawLine(
+        color = strokeColor,
+        start = Offset(0f, y),
+        end = Offset(size.width, y),
+        strokeWidth = sw,
+        alpha = p,
+    )
