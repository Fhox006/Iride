<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Metrolist" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Matches the app's own surface (dark by default, and pure black under the New Iride
             UI scheme). API 31+ derives the splash background from this too, so a cold start goes
             splash -> app on one colour instead of flashing white first. -->
        <item name="android:windowBackground">#000000</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Light-mode launch variant of Theme.Metrolist (implicit parent via dot notation): only the
         window/splash background changes, to the app's baseline light surface, so light-theme
         users don't get a one-frame dark flash at startup. Chosen programmatically in
         MainActivity.onCreate from the saved theme preference. -->
    <style name="Theme.Metrolist.Light">
        <item name="android:windowBackground">#FFFBFF</item>
    </style>

    <!-- Branded launch theme (androidx.core splashscreen API). Shows the Iride eye on a surface
         matching the app's default (dark) window, then hands off to the regular theme without a
         colour jump. On API 31+ the system renders the splash from these attributes; below that
         the library draws it, honouring the runtime setTheme() choice made in onCreate. -->
    <style name="Theme.Metrolist.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.Metrolist</item>
    </style>

    <!-- Light-mode variant of the branded launch theme. -->
    <style name="Theme.Metrolist.Splash.Light" parent="Theme.Metrolist.Splash">
        <item name="windowSplashScreenBackground">#FFFBFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo_light</item>
        <item name="postSplashScreenTheme">@style/Theme.Metrolist.Light</item>
    </style>

    <!-- Widget Theme with Material 3 colors fallback for API < 31 -->
    <style name="Theme.Widget.Metrolist" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:colorBackground">#E6E1E5</item>
    </style>

    <!-- Transparent theme for Music Recognizer Tile Service -->
    <style name="Theme.Metrolist.Transparent" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
